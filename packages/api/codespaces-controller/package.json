{
  "name": "@deepseek-ai/dsh-api-codespaces-controller",
  "description": "Codespaces environment Remote namespace: configuration, lifecycle, repository/branch/machine pickers, and the GitHub authorization flow bridge",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/codespaces-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-codespaces": "workspace:*",
    "@deepseek-ai/dsh-codespaces-connection": "workspace:*",
    "@deepseek-ai/dsh-codespaces-registry": "workspace:*",
    "@deepseek-ai/dsh-github-auth": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-codespaces": "workspace:*",
    "@deepseek-ai/dsh-codespaces-connection": "workspace:*",
    "@deepseek-ai/dsh-codespaces-registry": "workspace:*",
    "@deepseek-ai/dsh-github-auth": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*"
  }
}
